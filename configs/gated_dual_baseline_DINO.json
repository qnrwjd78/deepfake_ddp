{
    "_comment": "baseline_DINO: DINOv3 global (LoRA, sees WIDE/loose crop) + Swin local (LoRA, tight aligned crop) + FFT, per-branch SIGMOID gate. AdamW+cosine (PEFT). dual_view=true -> dataset emits both tight & wide. Same data as baseline (FF++ + newbench1 + newbench2 fake). Option B (wide=loose precrop, not true full frame — precrop has no full frames).",
    "model": "gated_dual_dino",
    "dual_view": true,

    "epoch": 100,
    "batch_size": 32,
    "image_size": 384,

    "global_backbone": "vit_large_patch16_dinov3.lvd1689m",
    "global_finetune": "lora",
    "global_img_size": 224,

    "local_backbone": "swin_base_patch4_window12_384",
    "local_finetune": "lora",
    "local_img_size": 384,

    "gate_mode": "sigmoid",
    "gate_temp": 2.35,
    "gate_hidden_dim": 256,

    "fft_cutoffs": [0.25, 0.4],
    "fft_ring_bw": 0.04,
    "fft_out_dim": 256,

    "optimizer": {
        "name": "SAM",
        "rho": 0.05,
        "base": { "name": "AdamW", "lr": 1e-4, "weight_decay": 0.01 }
    },
    "scheduler": { "name": "CosineDecayLR" },

    "align_crop": true,
    "fake_shift": true,
    "fake_shuffle": true,

    "real_frame_path": "data_precrop/FaceForensics++/original_sequences/youtube/raw/frames",
    "fake_frame_paths": [
        "data_precrop/FaceForensics++/manipulated_sequences/SimSwap/raw/frames",
        "data_precrop/FaceForensics++/manipulated_sequences/Deepfakes/c23/frames",
        "data_precrop/FaceForensics++/manipulated_sequences/Face2Face/c23/frames",
        "data_precrop/FaceForensics++/manipulated_sequences/FaceSwap/c23/frames",
        "data_precrop/FaceForensics++/manipulated_sequences/Deepfakes/c23/frames",
        "data_precrop/FaceForensics++/manipulated_sequences/Face2Face/c23/frames",
        "data_precrop/FaceForensics++/manipulated_sequences/FaceSwap/c23/frames",
        "data_precrop/FaceForensics++/manipulated_sequences/FaceShifter/raw/frames",
        "data_precrop/FaceForensics++/manipulated_sequences/NeuralTextures/c23/frames"
    ],

    "extra_train_sources": [
        { "frames": "data_precrop/newbench/train/frames",        "labels": "data/newbench/test/labels.csv" },
        { "frames": "data_precrop/new_benchmark_2/train/frames",  "labels": "data/new_benchmark_2/labels.csv", "fake_only": true }
    ]
}
