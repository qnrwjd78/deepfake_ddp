{
    "_comment": "Standalone XM recipe ported from deepfake_ddp. Existing v2 training files are untouched; normalized newbench and NB2 paths are merged as one logical extra source.",
    "model": "gated_dual",
    "epoch": 100,
    "batch_size": 40,
    "image_size": 384,
    "global_backbone": "vit_large_patch14_clip_224.openai",
    "global_finetune": "ln",
    "global_img_size": 224,
    "local_backbone": "swin_base_patch4_window12_384",
    "local_finetune": "full",
    "local_img_size": 384,
    "gate_mode": "gated",
    "gate_temp": 2.35,
    "gate_hidden_dim": 256,
    "fft_cutoffs": [
        0.25,
        0.4
    ],
    "fft_ring_bw": 0.04,
    "fft_out_dim": 256,
    "optimizer": {
        "name": "SAM",
        "rho": 0.05,
        "base": {
            "name": "SGD",
            "lr": 0.001,
            "momentum": 0.9
        }
    },
    "scheduler": {
        "name": "LinearDecayLR"
    },
    "sam_first_pass_sync": true,
    "cross_method_loss": {
        "enabled": true,
        "weight": 0.05,
        "margin": 0.2,
        "trusted_extra_real": true,
        "known_methods": [
            "SimSwap",
            "Deepfakes",
            "Face2Face",
            "FaceSwap",
            "FaceShifter",
            "NeuralTextures"
        ]
    },
    "align_crop": true,
    "precropped": true,
    "merge_extra_fake_sources": true,
    "expected_fake_domains": 6,
    "fake_shift": true,
    "fake_shuffle": true,
    "real_frame_path": "data_precrop/FaceForensics++/original_sequences/youtube/raw/frames",
    "fake_frame_paths": [
        "data_precrop/FaceForensics++/manipulated_sequences/SimSwap/raw/frames",
        "data_precrop/FaceForensics++/manipulated_sequences/Deepfakes/c23/frames",
        "data_precrop/FaceForensics++/manipulated_sequences/Face2Face/c23/frames",
        "data_precrop/FaceForensics++/manipulated_sequences/FaceSwap/c23/frames",
        "data_precrop/FaceForensics++/manipulated_sequences/FaceShifter/raw/frames",
        "data_precrop/FaceForensics++/manipulated_sequences/NeuralTextures/c23/frames"
    ],
    "extra_train_sources": [
        {
            "merged_labeled_sources": [
                {
                    "name": "newbench",
                    "frames": "data_precrop/newbench/train/frames",
                    "labels": "data/newbench/test/labels.csv"
                },
                {
                    "name": "new_benchmark_2",
                    "frames": "data_precrop/new_benchmark_2/train/frames",
                    "labels": "data/new_benchmark_2/labels.csv"
                }
            ]
        }
    ],
    "expected_xm_layout": {
        "source_count": 9,
        "real_frames": 26037,
        "fake_source_frames": [
            5499,
            5731,
            5744,
            5742,
            5744,
            5742,
            19041
        ]
    }
}
